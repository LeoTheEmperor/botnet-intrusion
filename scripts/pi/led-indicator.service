# Traffic-light LEDs driven from the dashboard API. Edit YOUR_USER, then see docs/PI_SETUP.md section 8.
[Unit]
Description=Traffic-light LED indicator for the botnet detector
After=botnet-detector.service

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/botnet-intrusion
ExecStart=/usr/bin/python3 src/led_indicator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
